{
  "name": "@circulusd/harness-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "circulusd-test harness backend: drives the real pi-runtime engine with in-memory stand-ins for the unfinished platform pieces (not production)",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --watch-path=src src/main.ts",
    "start": "node --env-file-if-exists=../.env src/main.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --test test/agent.test.ts"
  },
  "dependencies": {
    "@circulusd/pi-runtime": "workspace:*",
    "@circulusd/protocol-types": "workspace:*",
    "@earendil-works/pi-ai": "0.84.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  }
}
