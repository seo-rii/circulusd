{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circulusd.local/schemas/v1alpha/public-error.schema.json",
  "title": "Circulus Public Error v1alpha",
  "description": "A stable, structured error safe to expose to an authenticated API caller.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "code", "reason", "message", "retryable", "requestId"],
  "properties": {
    "apiVersion": {
      "const": "v1alpha"
    },
    "code": {
      "type": "string",
      "enum": [
        "invalid_argument",
        "unauthenticated",
        "permission_denied",
        "not_found",
        "already_exists",
        "conflict",
        "failed_precondition",
        "resource_exhausted",
        "aborted",
        "deadline_exceeded",
        "unavailable",
        "internal",
        "data_loss",
        "unsupported_protocol",
        "stale_generation",
        "digest_mismatch",
        "idempotency_conflict",
        "needs_confirmation"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,95}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "retryable": {
      "type": "boolean"
    },
    "retryAfterMs": {
      "$ref": "#/$defs/uint64"
    },
    "requestId": {
      "$ref": "#/$defs/opaqueId"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      },
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
