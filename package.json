{
  "name": "circulusd",
  "version": "0.3.0",
  "private": true,
  "description": "Offline multi-tenant Pi agent platform",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24.1.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "fuzz": "python3 scripts/fuzz.py",
    "fuzz:list": "python3 scripts/fuzz.py --list",
    "generate:workerd-fixture": "esbuild internal/conformance/workerd/fixture/pi-worker.entry.ts --bundle --format=esm --platform=browser --target=es2022 --external:cloudflare:sockets --outfile=internal/conformance/workerd/fixture/pi-worker.mjs",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern packages workers",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "fast-check": "4.9.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
