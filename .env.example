# Copy this file to .env (repo root); `pnpm dev` / `pnpm start` load it when it exists.
# Backend bind address (loopback only by default)
CIRCULUSD_TEST_HOST=127.0.0.1
CIRCULUSD_TEST_PORT=8090

# Chat sessions kept in memory; beyond this the longest-idle session without a running turn is evicted
# (its python sandbox is released too). Nothing survives a restart anyway.
# CIRCULUSD_TEST_MAX_SESSIONS=200

# Model provider spec. One of:
#   mock                                        deterministic, no network, exercises tool calls
#   ollama:<model>[@<base-url>]                 local Ollama, e.g. ollama:qwen3:8b; base URL defaults to
#                                               OLLAMA_HOST or http://127.0.0.1:11434/v1; the model must be pulled
#   anthropic:<model-id>                        e.g. anthropic:claude-sonnet-4-5  (needs ANTHROPIC_API_KEY)
#   openai-compatible:<model-id>@<base-url>     any other OpenAI-compatible server (OPENAI_API_KEY optional)
CIRCULUSD_TEST_MODEL=ollama:qwen3:8b
#OLLAMA_HOST=127.0.0.1:11434

# Prepend the session's earlier user/assistant turns to each model request (1 = on, 0 = off).
# The circulusd Pi adapter itself starts every turn from a fresh state; this is a test-harness convenience.
CIRCULUSD_TEST_HISTORY=1

#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# python tool: interpreter override (default: python/py on Windows, python3/python elsewhere) and wall-clock limit
# CIRCULUSD_TEST_PYTHON=C:/Python314/python.exe
# CIRCULUSD_TEST_PYTHON_TIMEOUT_MS=30000

# python tool execution: circulusd (default; one sandboxd per session inside WSL2 via sandbox/agent), host (no isolation, unsafe), off
# CIRCULUSD_TEST_SANDBOX=circulusd
# CIRCULUSD_TEST_SANDBOX_DISTRO=Ubuntu-26.04        # WSL distribution; default = the default distro
# CIRCULUSD_TEST_SANDBOX_LAUNCHER=auto              # auto|nsjail|docker|unshare (auto = nsjail if installed, else docker if the daemon answers, else unshare)
# CIRCULUSD_TEST_SANDBOX_IMAGE=python:3.14-slim     # container image for the docker launcher
# CIRCULUSD_TEST_SANDBOX_PYTHON=/usr/bin/python3    # interpreter inside the WSL distro
# CIRCULUSD_TEST_SANDBOX_WORKSPACE_SIZE=256m        # tmpfs /workspace size inside each session's sandbox
# CIRCULUSD_TEST_SANDBOX_MAX_SESSIONS=16            # session sandboxes kept at once (least recently used idle one is evicted)
# CIRCULUSD_TEST_SANDBOX_SESSION_IDLE=1h            # stop a session's sandbox (and drop its /workspace) after this idle time; 0 = never
