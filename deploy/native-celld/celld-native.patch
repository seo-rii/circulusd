+async fn circulusd_native_probe(request: Request<Incoming>, path: &str) -> HttpReply {
+    let native = celld::circulusd_native::content_type(path).expect("reserved native route");
+    let exact = |name: &str, value: &str| {
+        let values = request.headers().get_all(name).iter().collect::<Vec<_>>();
+        values.len() == 1 && values[0].as_bytes() == value.as_bytes()
+    };
+    if request.method() != hyper::Method::POST || request.uri().query().is_some()
+        || !exact("content-type", native) || !exact("accept", native) || !exact("cache-control", "no-store")
+        || request.headers().contains_key("content-encoding")
+        || request.headers().contains_key("upgrade")
+        || request.headers().contains_key("x-circulus-storage-key-id")
+        || request.headers().contains_key("x-circulus-storage-signature")
+        || request.headers().contains_key("x-circulus-state-key-id")
+        || request.headers().contains_key("x-circulus-state-signature") {
+        return response(StatusCode::BAD_REQUEST, "invalid native probe");
+    }
+    let mut incoming = request.into_body();
+    let held = tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        let mut body = Vec::new();
+        while let Some(frame) = incoming.frame().await {
+            let frame = frame.map_err(|_| ())?;
+            if let Some(data) = frame.data_ref() {
+                if body.len().saturating_add(data.len()) > 256 { return Err(()); }
+                body.extend_from_slice(data);
+            } else { return Err(()); }
+        }
+        Ok(body)
+    }).await;
+    let Ok(Ok(body)) = held else {return response(StatusCode::BAD_REQUEST, "invalid native probe");};
+    let Ok(nonce) = celld::circulusd_native::decode_challenge(path, &body) else {
+        return response(StatusCode::BAD_REQUEST, "invalid native probe");
+    };
+    match celld::circulusd_native::response(path, &nonce) {
+        Ok(Some(body)) => Response::builder().status(StatusCode::OK)
+            .header("content-type", native).header("cache-control", "no-store")
+            .body(Full::new(Bytes::from(body)).map_err(|never| match never {}).boxed_unsync())
+            .expect("static native CBOR response"),
+        Ok(None) => response(StatusCode::NOT_FOUND, "native proof unavailable"),
+        Err(_) => response(StatusCode::SERVICE_UNAVAILABLE, "native proof unavailable"),
+    }
+}
